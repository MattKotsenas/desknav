root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
charset = utf-8-bom
indent_style = space
indent_size = 4

[*.{json,jsonc,yml,yaml,xml,props,targets,slnx,md}]
indent_style = space
indent_size = 2

[*.ps1]
indent_style = space
indent_size = 4
